{
  "name": "dj-dudes",
  "productName": "DJ Dudes",
  "version": "1.0.0",
  "description": "Two-deck DJ software: queue songs on side A and B and crossfade between them, by hand or with automix.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "npx --yes electron-builder@26 --win portable"
  },
  "devDependencies": {
    "electron": "^44.7.2"
  },
  "build": {
    "appId": "com.djdudes.app",
    "productName": "DJ Dudes",
    "files": [
      "main.js",
      "preload.js",
      "remote-server.js",
      "remote.html",
      "index.html",
      "style.css",
      "app.js",
      "youtube.js",
      "icon.png",
      "icon.ico"
    ],
    "icon": "icon.ico",
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "portable": {
      "artifactName": "DJ Dudes.exe"
    }
  },
  "dependencies": {
    "qrcode-generator": "^2.0.4"
  }
}
